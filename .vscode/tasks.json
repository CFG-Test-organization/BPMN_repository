{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "BPMN: Експорт в SVG",
      "type": "shell",
      "command": "npx bpmn-to-image \"${file};${fileDirname}/${fileBasenameNoExtension}.svg\"",
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "close": true
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "BPMN: Порівняти схеми",
      "type": "shell",
      "command": "node ./scripts/diff-main.js \"${file}\"",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}